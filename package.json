{
  "name": "xstoryphone",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run assets:build && npm run scenario:build && WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_ENV=dev VITE_XSTORYPHONE_RESET_FOR_TESTING=true vite --host 127.0.0.1",
    "build": "npm run build:cloudflare:dev",
    "build:cloudflare": "npm run build:cloudflare:dev",
    "build:cloudflare:target": "npm run assets:build && npm run scenario:build && WRANGLER_LOG_PATH=.wrangler/logs vite build",
    "build:cloudflare:dev": "CLOUDFLARE_ENV=dev VITE_XSTORYPHONE_RESET_FOR_TESTING=true npm run build:cloudflare:target",
    "build:cloudflare:stg": "CLOUDFLARE_ENV=stg VITE_XSTORYPHONE_RESET_FOR_TESTING=true npm run build:cloudflare:target",
    "build:cloudflare:prod": "CLOUDFLARE_ENV=prod VITE_XSTORYPHONE_RESET_FOR_TESTING=false npm run build:cloudflare:target",
    "build:aws": "npm run assets:build && npm run scenario:build && npm run audit:aws:scenario && BUILD_PLATFORM=aws vite build",
    "build:static": "node scripts/build-static.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:cloudflare:dev": "node scripts/deploy-cloudflare.mjs dev",
    "deploy:cloudflare:stg": "node scripts/deploy-cloudflare.mjs stg",
    "deploy:cloudflare:prod": "node scripts/deploy-cloudflare.mjs prod",
    "deploy:aws:dev": "node scripts/deploy-aws.mjs dev",
    "deploy:aws:stg": "node scripts/deploy-aws.mjs stg",
    "deploy:aws:prod": "node scripts/deploy-aws.mjs prod",
    "check": "npm run assets:build && npm run scenario:build && npm run audit:client && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/test.mjs",
    "assets:build": "node scripts/generate-search-agent-sprites.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "audit:client": "node scripts/audit-client-boundary.mjs",
    "audit:client:cloudflare": "node scripts/audit-client-boundary.mjs dist/client",
    "audit:client:aws": "node scripts/audit-client-boundary.mjs dist/aws",
    "audit:client:static": "node scripts/audit-client-boundary.mjs dist/static",
    "audit:aws:scenario": "node scripts/audit-aws-scenario.mjs",
    "aws:validate": "SAM_CLI_TELEMETRY=0 sam validate --lint --template-file infra/aws/template.yaml",
    "aws:build": "SAM_CLI_TELEMETRY=0 sam build --template-file infra/aws/template.yaml",
    "scenario:validate": "node scripts/scenario-validate.mjs",
    "scenario:build": "node scripts/scenario-build.mjs",
    "scenario:static:init": "node scripts/static-parts-init.mjs",
    "scenario:sheets:pull": "node scripts/scenario-sheets-pull.mjs",
    "scenario:sheets:compare": "node scripts/scenario-sheets-compare.mjs",
    "scenario:sheets:put": "node scripts/scenario-sheets-put.mjs",
    "scenario:talk-flow:criteria:audit": "node scripts/scenario-talk-flow-criteria-audit.mjs",
    "scenario:talk-flow:cases:test": "node scripts/scenario-talk-flow-cases-test.mjs",
    "scenario:hooks:cases:test": "node scripts/scenario-hook-cases-test.mjs",
    "scenario:talk-flow:path-dump": "node scripts/scenario-talk-flow-path-dump.mjs",
    "scenario:talk-flow:writer-review": "node scripts/scenario-talk-flow-writer-review-dump.mjs",
    "scenario:talk-flow:writer-review:test": "node scripts/scenario-talk-flow-writer-review-dump-test.mjs",
    "scenario:talk-flow:examples:test": "node scripts/scenario-llm-talk-flow-examples-test.mjs",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply xstoryphone-dev --local --env dev",
    "db:migrate:remote": "node scripts/require-explicit-migration-target.mjs",
    "db:migrate:remote:dev": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply xstoryphone-dev --remote --env dev",
    "db:migrate:remote:stg": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply xstoryphone-stg --remote --env stg",
    "db:migrate:remote:prod": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply xstoryphone --remote --env prod",
    "review:analyze": "node scripts/analyze-talk-branch-review-clusters.mjs",
    "access-code": "node scripts/generate-access-code.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.8.0",
    "hono": "^4.12.14",
    "howler": "^2.2.4",
    "svelte": "^5.55.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/howler": "^2.2.12",
    "@types/node": "^25.6.0",
    "fake-indexeddb": "^6.2.5",
    "svelte-check": "^4.4.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "wrangler": "^4.84.1"
  }
}
