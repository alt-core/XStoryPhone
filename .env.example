# 正規表現だけのデモは、LLM用の環境変数なしで動作します。
# LLMを使う場合は scenario.json の features.llm を true にし、次を設定します。
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_MS=15000
# 対応するLLM providerへ既定値と異なる推論強度を渡す場合だけ設定します。
# LLM_REASONING_EFFORT=

# hookのmatch処理では fast / super / ultra を選べます。fastだけLLM_MODELへfallbackします。
# LLM_PROFILE_FAST_MODEL=
# LLM_PROFILE_FAST_REASONING_EFFORT=
# LLM_PROFILE_FAST_TIMEOUT_MS=
# LLM_PROFILE_SUPER_MODEL=
# LLM_PROFILE_SUPER_REASONING_EFFORT=
# LLM_PROFILE_SUPER_TIMEOUT_MS=
# LLM_PROFILE_ULTRA_MODEL=
# LLM_PROFILE_ULTRA_REASONING_EFFORT=
# LLM_PROFILE_ULTRA_TIMEOUT_MS=

# token使用量・試行回数・hashだけを構造化logへ出す場合に有効にします。本文は出ません。
# LLM_ANALYTICS_ENABLED=false
# 入力、prompt、schema、provider応答を調査中だけlogへ出します。公開環境では調査後にfalseへ戻してください。
# LLM_DEBUG_LOGS=false
# serverモードのhook LLM結果を保持する日数です。未指定時は30日です。
# LLM_RESULT_RETENTION_DAYS=30

# 公開環境のレビュー画面を保護します。ローカルでは空欄のまま利用できます。
# ADMIN_REVIEW_SECRET=
# browserモードの進行状態へ署名する秘密値です。serverモードでは不要です。
# BROWSER_STATE_SECRET=
# serverモードで発行済み8桁アクセスコードだけを受理する場合に、生成と判定で同じ値を使います。
# ACCESS_CODE_SECRET=
# 実行環境です。CloudflareとAWSのデプロイスクリプトが対象環境に合わせて設定します。
# APP_ENV=development

# 実プレイの検索語・会話入力を監修集計用テーブルへ記録する場合だけ有効にします。
# PLAYER_INPUT_LOGGING=false

# 外部静的ホストから接続するAPIのoriginです。末尾に/apiや配置pathを付けません。
# 未指定は従来の同一originの/api/...へ接続します。公開先はHTTPS、HTTPはlocalhost限定です。
# VITE_XSTORYPHONE_API_BASE_URL=https://api.example
# 静的配置pathは環境変数で増やさず、npm run build:static -- --base=/works/story/ で指定します。
# 本番の外部静的buildではfalseを指定します。trueのときだけテスト用reset入口も生成します。
# VITE_XSTORYPHONE_RESET_FOR_TESTING=false

# API側のCORS許可originです。カンマ区切りで指定し、path、*、nullは使いません。
# AWS配備ではshell環境変数、Cloudflareではwrangler.jsoncの対象env.varsへ設定します。
# このファイルを編集するだけでは、これらのAPI配備設定へ自動反映されません。
# 未指定・空文字は外部originへのCORS許可を付けず、従来の同一origin構成を維持します。
# ALLOWED_ORIGINS=https://static.example,https://preview.example
# 手順と共有originの信頼境界: docs/xstoryphone/external-hosting.md

# プレイヤー画面の保存名へ付ける公開prefixです。秘密値ではありません。
# 他作者と同じoriginでpersistentを公開する場合は、重複しない値を必ず指定します。
# 未指定は従来の保存名を維持します。変更しても旧保存の移行・削除は行いません。
# VITE_XSTORYPHONE_STORAGE_PREFIX=author-work-prod
# persistent（既定）またはmemory。memoryはplayerMode: browser専用です。
# memoryはページ内だけに保持し、通常reloadで最初からになります。GA4も無効です。
# server + memoryや不明値、prefixの前後空白はdev起動・クライアントビルドで拒否します。
# VITE_XSTORYPHONE_CLIENT_STORAGE=persistent

# 任意: GA4でアプリ操作と匿名化したクライアントエラーを計測する場合だけ設定します。
# VITE_XSTORYPHONE_CLIENT_STORAGE=memoryでは、設定済みでもGA4を読み込みません。
# 有効にする場合は、実際の送信内容に合わせてプライバシーポリシーも更新してください。
# VITE_XSTORYPHONE_GA4_MEASUREMENT_ID=
